# Relay web client
# Leave empty to use this app's own Next.js API routes (app/api/**).
# Only set this if you are running the separate Express + Socket.io API.
# No separate backend is required for auth/chat in this repo.
NEXT_PUBLIC_API_URL=

# Public URL used to build links in transactional emails.
# Local: http://localhost:3000
# Production: https://relay-messengerpro.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Transactional email (Resend). Without RESEND_API_KEY the forgot-password
# endpoint logs the reset link to stdout instead of sending an email.
RESEND_API_KEY=
EMAIL_FROM=Relay Messenger <onboarding@resend.dev>

# Generative AI for Relay AI assistant. Provide a Google Gemini key so the
# assistant can answer any general-knowledge, coding, math, or creative
# question live. Without it, a smart local fallback keeps replies working.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Supabase (Postgres + Realtime)
# Client-safe values (Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used by server actions to write messages without RLS blocking.
SUPABASE_SERVICE_ROLE_KEY=
